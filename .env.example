# LLM API Keys (Choose at least one)
# OpenAI API Key (used for embeddings in ChromaDB and/or GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (optional, used for NVIDIA Nemotron or other open-weight models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Neo4j Graph Database Configuration (defaults to in-memory NetworkX if not configured)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password
