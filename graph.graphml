<node id="fest:durgotsab_2026">
  <data key="d0">Festival</data>
  <data key="d1">IISc Sharodiya Durgotsab 2026: Durga Puja at IISc Bengaluru</data>
  <data key="d5">2026</data>
  <data key="d6">2026-10-16T08:30:00+05:30</data>
  <data key="d7">2026-10-21</data>
  <data key="d8">True</data>
  <data key="d9">The Durga Puja of the Indian Institute of Science, Bengaluru. Five days of ritual, art and homecoming on a campus built for the pursuit of knowledge. Powered by Genotypic Group. Free and open to everyone.</data>
  <data key="d10">['bn', 'en']</data>
